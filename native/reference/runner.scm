; Test-only runner for the unmodified official compiler and libraries.
(require mzscheme json)
(require "ac.scm")
(require "brackets.scm")
(use-bracket-readtable)
(aload "arc.arc")
(aload "libs.arc")
(aload "news.arc")
(let loop ()
  (let ((source (read-json)))
    (unless (eof-object? source)
      (with-handlers ((exn:fail? (lambda (e)
                                 (write-json (hash 'error (exn-message e)))
                                 (newline)
                                 (flush-output))))
        (let ((result (parameterize ((current-output-port (open-output-string)))
                        (arc-eval (read (open-input-string source))))))
          (write-json (hash 'result (if (string? result) result
                                       (with-output-to-string (lambda () (write (ac-denil result)))))))
          (newline)
          (flush-output)))
      (loop))))
