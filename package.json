{
  "name": "arc-news-workers",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8787",
    "check": "node scripts/check-native.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "node scripts/build-native.mjs && node --test native/test/*.test.mjs",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "5.20261113.0-beta",
    "wrangler": "4.162.0"
  },
  "description": "Official Arc News 3.2 running in a JavaScript Arc VM on Cloudflare Workers"
}
