{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arc-news-workers",
  "main": "native/worker.js",
  "compatibility_date": "2026-11-16",
  "build": {
    "command": "node scripts/build-native.mjs"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "NEWS",
        "class_name": "ArcNews"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ArcNews"
      ]
    }
  ]
}
